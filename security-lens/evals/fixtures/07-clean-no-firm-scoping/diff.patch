+using MediatR;
+using Microsoft.EntityFrameworkCore;
+
+namespace MatterDesk.Api.Queries.Cases;
+
+public class ListOpenCasesQueryHandler : IRequestHandler<ListOpenCasesQuery, Result<List<CaseSummaryDto>>>
+{
+    private readonly BaseDbContext _db;
+
+    public ListOpenCasesQueryHandler(BaseDbContext db)
+    {
+        _db = db;
+    }
+
+    public async Task<Result<List<CaseSummaryDto>>> Handle(ListOpenCasesQuery request, CancellationToken ct)
+    {
+        var cases = await _db.Cases
+            .Where(c => c.Status == CaseStatus.Open)
+            .OrderByDescending(c => c.CreatedAt)
+            .ToListAsync(ct);
+
+        return Result.Success(cases.Select(CaseSummaryDto.From).ToList());
+    }
+}
